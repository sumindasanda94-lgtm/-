@charset "utf-8";

:root { --bg: #f3f6f9; --card: #fff; --ink: #17212b; --muted: #687787; --line: #dce4ea; --brand: #17324d; --brand2: #245c83; --ok: #14804a; --warn: #b86a00; --danger: #b3261e; --shadow: 0 5px 20px rgba(23,50,77,.09); --r: 16px; }

* { box-sizing: border-box; }

body { margin: 0px; background: var(--bg); font-family: system-ui, "Noto Sans Sinhala", sans-serif; color: var(--ink); }

button, input, select, textarea { font: inherit; }

button { cursor: pointer; border: 0px; }

.app { min-height: 100vh; }

header { position: sticky; top: 0px; z-index: 20; background: linear-gradient(135deg,var(--brand),var(--brand2)); color: rgb(255, 255, 255); padding: 12px 14px; box-shadow: rgba(0, 0, 0, 0.133) 0px 3px 12px; }

.head { max-width: 1400px; margin: auto; display: flex; gap: 12px; align-items: center; justify-content: space-between; }

.brand h1 { font-size: 19px; margin: 0px; }

.brand small { opacity: 0.82; }

.head-actions { display: flex; gap: 7px; flex-wrap: wrap; }

.iconbtn, .navbtn { background: rgba(255, 255, 255, 0.094); color: rgb(255, 255, 255); border: 1px solid rgba(255, 255, 255, 0.19); padding: 9px 11px; border-radius: 11px; }

.layout { max-width: 1400px; margin: auto; padding: 14px; display: grid; grid-template-columns: 230px 1fr; gap: 14px; }

aside { position: sticky; top: 82px; height: max-content; background: var(--card); border: 1px solid var(--line); border-radius: var(--r); padding: 10px; box-shadow: var(--shadow); }

nav button { display: block; width: 100%; text-align: left; background: transparent; padding: 12px; border-radius: 11px; margin: 3px 0px; color: var(--ink); }

nav button.active, nav button:hover { background: rgb(233, 242, 248); color: var(--brand); font-weight: 700; }

main { min-width: 0px; }

.page { display: none; }

.page.active { display: block; }

.grid { display: grid; gap: 12px; }

.metrics { grid-template-columns: repeat(4, 1fr); }

.metric { background: var(--card); padding: 16px; border: 1px solid var(--line); border-radius: var(--r); box-shadow: var(--shadow); }

.metric b { font-size: 25px; display: block; margin-top: 5px; }

.muted { color: var(--muted); font-size: 13px; }

.panel { background: var(--card); border: 1px solid var(--line); border-radius: var(--r); box-shadow: var(--shadow); padding: 14px; margin-bottom: 12px; }

.panel h2, .panel h3 { margin: 0px 0px 11px; }

.toolbar { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }

.toolbar > * { flex: 0 1 auto; }

input, select, textarea { border: 1px solid rgb(203, 215, 223); background: rgb(255, 255, 255); padding: 10px; border-radius: 10px; outline: none; min-width: 0px; }

input:focus, select:focus, textarea:focus { border-color: var(--brand2); box-shadow: rgba(36, 92, 131, 0.09) 0px 0px 0px 3px; }

.btn { padding: 10px 13px; border-radius: 10px; font-weight: 700; }

.primary { background: var(--brand); color: rgb(255, 255, 255); }

.secondary { background: rgb(233, 242, 248); color: var(--brand); }

.success { background: rgb(227, 246, 236); color: var(--ok); }

.danger { background: rgb(253, 233, 231); color: var(--danger); }

.warning { background: rgb(255, 242, 220); color: var(--warn); }

.productgrid { display: grid; grid-template-columns: repeat(4, minmax(0px, 1fr)); gap: 10px; }

.product { border: 1px solid var(--line); border-radius: 14px; padding: 11px; background: rgb(255, 255, 255); display: flex; flex-direction: column; gap: 7px; min-height: 170px; }

.product .pic { height: 55px; border-radius: 12px; background: linear-gradient(135deg, rgb(237, 244, 248), rgb(220, 235, 243)); display: grid; place-items: center; font-size: 26px; }

.product h3 { font-size: 14px; margin: 0px; }

.tags { display: flex; gap: 5px; flex-wrap: wrap; }

.tag { font-size: 11px; background: rgb(238, 243, 246); padding: 4px 6px; border-radius: 999px; }

.stock { font-size: 12px; font-weight: 700; }

.stock.ok { color: var(--ok); }

.stock.low { color: var(--warn); }

.stock.out { color: var(--danger); }

.sale-layout { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: 12px; }

.cart { position: sticky; top: 82px; height: max-content; }

.cartrow { display: grid; grid-template-columns: 1fr auto auto; gap: 8px; align-items: center; border-bottom: 1px solid var(--line); padding: 10px 0px; }

.qty { display: flex; align-items: center; gap: 5px; }

.qty button { width: 29px; height: 29px; border-radius: 8px; background: rgb(237, 242, 245); }

.summary { display: grid; gap: 7px; margin-top: 12px; }

.sumrow { display: flex; justify-content: space-between; }

.grand { font-size: 20px; font-weight: 800; border-top: 2px solid var(--brand); padding-top: 10px; }

.receipt { font-family: monospace; background: rgb(255, 255, 255); padding: 16px; max-width: 420px; margin: auto; border: 1px dashed rgb(170, 170, 170); }

.receipt .center { text-align: center; }

.receipt table { width: 100%; border-collapse: collapse; }

.receipt td { padding: 3px 0px; vertical-align: top; }

.receipt .right { text-align: right; }

.receipt .line { border-top: 1px dashed rgb(119, 119, 119); margin: 7px 0px; }

table.data { width: 100%; border-collapse: collapse; font-size: 13px; }

table.data th, table.data td { padding: 9px 7px; border-bottom: 1px solid var(--line); text-align: left; }

table.data th { background: rgb(242, 246, 248); }

.modal { display: none; position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.533); z-index: 50; padding: 15px; overflow: auto; }

.modal.show { display: block; }

.modalbox { background: rgb(255, 255, 255); max-width: 850px; margin: 25px auto; border-radius: 18px; padding: 16px; }

.close { float: right; background: rgb(237, 242, 245); border-radius: 9px; padding: 7px 10px; }

.formgrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }

.field { display: grid; gap: 5px; }

.field.full { grid-column: 1 / -1; }

.field label { font-size: 12px; color: var(--muted); font-weight: 700; }

.bottom { display: none; }

.empty { text-align: center; padding: 30px; color: var(--muted); }

.badge { display: inline-block; padding: 4px 7px; border-radius: 999px; background: rgb(232, 245, 237); color: var(--ok); font-size: 11px; font-weight: 700; }

@media (max-width: 1000px) {
  .layout { grid-template-columns: 1fr; }
  .layout aside { display: none; }
  .productgrid { grid-template-columns: repeat(3, 1fr); }
  .sale-layout { grid-template-columns: 1fr; }
  .cart { position: static; }
  .bottom { display: grid; position: fixed; bottom: 0px; left: 0px; right: 0px; background: rgb(255, 255, 255); border-top: 1px solid var(--line); grid-template-columns: repeat(5, 1fr); z-index: 30; padding: 5px; }
  .bottom button { background: rgb(255, 255, 255); padding: 8px 2px; font-size: 11px; }
  .bottom button.active { color: var(--brand); font-weight: 800; }
}

@media (max-width: 620px) {
  .metrics { grid-template-columns: repeat(2, 1fr); }
  .productgrid { grid-template-columns: repeat(2, 1fr); }
  .formgrid { grid-template-columns: 1fr; }
  .head-actions .wide { display: none; }
  .layout { padding: 9px; }
  .panel { padding: 11px; }
  .receipt { font-size: 12px; }
}

@media print {
  body { background: rgb(255, 255, 255); }
  .no-print, header, aside, .bottom { display: none !important; }
  .layout { display: block; padding: 0px; }
  .page { display: none !important; }
  .page.print-page { display: block !important; }
  .receipt { border: 0px; box-shadow: none; max-width: none; }
}
